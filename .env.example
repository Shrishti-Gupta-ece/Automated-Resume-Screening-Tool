# Application Configuration Template
# Copy this file to .env and customize values as needed.
# Note: The .env file is excluded from Git to prevent exposing local settings.

# Application Environment (development, testing, production)
APP_ENV=development

# Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Default Screening Parameters
DEFAULT_MIN_YEARS_EXPERIENCE=2.0
DEFAULT_PASSING_SCORE_THRESHOLD=0.60
DEFAULT_MIN_MUST_COVERAGE=0.60
KEYWORD_STUFFING_LIMIT=6
